type Package := struct {
	name version description license repository homepage src root : str
};

type ExecContext := struct {
	function_name module_name path : str,
	span : range
};

type gen:<T> := struct { data : fn () -> T?, index : int, done : bool };

const print := fn (msg : list:<str>) => {
	let mut txt := "";
	for m in msg => txt &= m;
	
	return console_output(1, txt & "\n");
};

@pure
const range := fn (start end : mut int, step : int = 1, inclusive : bool = false) -> gen:<int> => {
	if (start != INT_MIN) && (end = INT_MIN) => {
		end := start;
		start := 0;
	} else if (start = INT_MIN) && (end = INT_MIN) => return;
	
	if inclusive => end += step;
	
	let mut index : int = start;
	
	for ((index < end) && (step > 0)) || ((index > end) && (step < 0)) => {
		return index;
		index += step;
	};
	
};

@pure
const fmt := fn (splits : list:<str>, inputs : list:<str>) -> str => {
	let mut txt : str = "";
	
	for i in len(splits) => {
		txt &= splits[i]!;
		if let .Some : x <- inputs[i] => txt &= x;
	};
	
	return txt;
};