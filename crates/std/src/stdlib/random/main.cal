const RAND_MAX := 2147483647;

const generate := fn -> int => return try rand(-RAND_MAX..RAND_MAX) as int => 0;

const bool := fn -> bool => return rand(0..=100) > 50.0;

const ratio := fn -> float => return rand(0..RAND_MAX) / (try RAND_MAX as float => 1f);

const range := fn (min max : int, inclusive : bool = false) -> int => {
	if inclusive => max += 1;
	if max <= min => return min else => {
		return try rand(min..max) as int => 0;
	};
};

const float_range := fn (min max : int) -> float => {
	if max <= min => return min else => return rand(min..max);
};

const choice := fn <T> (values : list:<T>) -> T? => {
	if len(values) = 0 => return none;
	let idx := range(0, len(values));
	return some(values[idx]);
};
