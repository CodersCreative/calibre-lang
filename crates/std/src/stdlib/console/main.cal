const stdout := fn (msg : list:<str>) => {
	let mut txt := "";
	for m in msg => txt &= m;
	
	console_output(1, txt);
};

const stderr := fn (msg : list:<str>) => {
	let mut txt := "";
	for m in msg => txt &= m;
	
	console_output(2, txt);
};

const clear := fn => {
	console_output(1, "x1b[2Jx1b[1;1H");
};

const stdin := fn (prompt : str) -> str => {
	out(prompt);
	return console_input();
};

@ignore_invalid_return
@returns_gen
const stream_stdin := fn() -> gen:<str> =>
	return input_stream();