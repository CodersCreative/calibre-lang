const out := fn (msg : list:<dyn>) => {
	let mut txt := "";
	for m in msg => txt &= m;
	
	console_output(1, txt)
};

const stderr := fn (msg : list:<dyn>) => {
	let mut txt := "";
	for m in msg => txt &= m;

	console_output(2, txt)
};

const clear := fn => {
	out("x1b[2Jx1b[1;1H");
	null;
};

const input := fn (prompt : dyn) -> str => {
	out(prompt);
	return console_input();
};
