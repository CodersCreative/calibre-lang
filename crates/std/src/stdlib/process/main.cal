import * from std::str;

// Based on exitcode crate
const EXIT_CANTCREAT := 73u;
const EXIT_CONFIG := 78u;
const EXIT_DATAERR := 65u;
const EXIT_IOERR := 74u;
const EXIT_NOHOST := 68u;
const EXIT_NOINPUT := 66u;
const EXIT_NOPERM := 77u;
const EXIT_NOUSER := 67u;
const EXIT_OK := 0u;
const EXIT_OSERR := 71u;
const EXIT_OSFILE := 72u;
const EXIT_PROTOCOL := 76u;
const EXIT_SOFTWARE := 70u;
const EXIT_TEMPFAIL := 75u;
const EXIT_UNAVAILABLE := 69u;
const EXIT_USAGE := 64u;

type ProcessResult := struct {
	command : str,
	status : int,
	success : bool,
	stdout stderr : str
};

type ExecOptions := struct {
	command : str,
	args : list:<str>,
	cwd : str?,
	shell : bool,
	stdin : str?,
	check : bool
};

type Process := struct { };

impl Process {
	const options :=
		fn (command : str) -> ExecOptions => return ExecOptions {command, args : list:<str>[], cwd : none, shell : false, stdin : none, check : false};

	const raw := fn (options : ExecOptions) -> str!ProcessResult => return raw_exec(options);

	const run :=
		fn (program : str, args : list:<str>) -> str!ProcessResult => return Process.raw(ExecOptions {command : program, args, cwd : none, shell : false, stdin : none, check : false});

	const run_in :=
		fn (program : str, args : list:<str>, cwd : str) -> str!ProcessResult => return Process.raw(ExecOptions {command : program, args, cwd : some(cwd), shell : false, stdin : none, check : false});

	const shell :=
		fn (command : str) -> str!ProcessResult => return Process.raw(ExecOptions {command, args : list:<str>[], cwd : none, shell : true, stdin : none, check : false});

	const which := fn (program : str) -> str? => {
		let out := try Process.shell("command -v " & program) : _ => return none;
		let path := out.stdout.trim();
		if len(path) = 0 => return none else => return some(path);
	};
};