extern "c" const c_usleep := fn(@int) -> @int from "libc" as "usleep";

const wait := fn (ms : int = 1000) => if ms <= 0 => {} else => c_usleep(ms * 1000);

type Duration := struct { ms : int };

impl Duration {
	const from_ms := fn (ms : int) -> Duration => return Duration { ms };

	const from_s := fn (secs : int) -> Duration => return Duration { ms : secs * 1000 };

	const from_us := fn (us : int) -> Duration => return Duration { ms : us / 1000 };

	const as_ms := fn (self : Duration) -> int => return self.ms;

	const as_s := fn (self : Duration) -> int => return self.ms / 1000;

	const is_zero := fn (self : Duration) -> bool => return self.ms <= 0;

	const sleep := fn (self : Duration) => wait(self.ms);
};

const sleep := fn (d : Duration) => d.sleep();