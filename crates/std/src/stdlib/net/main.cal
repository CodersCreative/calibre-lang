import * from std::str;

type TcpStream := struct { inner : host };
type TcpListener := struct { inner : host };

type HttpResponse := struct { status : int, headers : list:<str>, body : str };
type HttpClient := struct {
	host : str,
	port : int,
	headers : list:<str>,
	scheme : str
};

type Tcp := struct { };
type Http := struct { };

impl Tcp {
	const connect := fn (host : str, port : int = 80) -> TcpStream => return TcpStream { inner : tcp_connect(host, port) };

	const listen := fn (host : str, port : int = 8080) -> TcpListener => return TcpListener { inner : tcp_listen(host, port) };

	const accept := fn (listener : TcpListener) -> TcpStream => return TcpStream { inner : tcp_accept(listener.inner) };

	const read := fn (stream : TcpStream, size : int = 4096) -> str => return tcp_read(stream.inner, size);

	const write := fn (stream : TcpStream, data : str) -> int => return tcp_write(stream.inner, data);

	const close := fn (stream : TcpStream) => return tcp_close(stream.inner);
};

impl TcpStream {
	const connect := fn (host : str, port : int = 80) -> TcpStream => return Tcp.connect(host, port);

	const read := fn (self : &TcpStream, size : int = 4096) -> str => return tcp_read(self.inner, size);

	const write := fn (self : &TcpStream, data : str) -> int => return tcp_write(self.inner, data);

	const close := fn (self : &TcpStream) => return tcp_close(self.inner);
};

impl TcpListener {
	const listen := fn (host : str, port : int = 8080) -> TcpListener => return Tcp.listen(host, port);

	const accept := fn (self : &TcpListener) -> TcpStream => return TcpStream { inner : tcp_accept(self.inner) };
};

const strip_prefix := fn (s prefix : str) -> str => {
	let parts := split(s, prefix);
	if len(parts) <= 1 => s;
	let mut out := "";
	let mut idx := 1;
	
	for idx < len(parts) => {
		if idx > 1 => out &= prefix;
		out &= parts[idx];
		idx = idx + 1;
	};
	
	return out;
};

const default_port := fn (scheme : str) -> int => if scheme = "https" => return 443 else => return 80;

const normalize_host := fn (host : str) -> str => {
	let mut out := host;
	if starts_with(out, "https://") => out = strip_prefix(out, "https://");
	if starts_with(out, "http://") => out = strip_prefix(out, "http://");
	return out;
};

const infer_scheme :=
	fn (host : str, port : int) -> str => {
		if starts_with(host, "https://") => return "https" else => if starts_with(host, "http://") => return "http" else => if port = 443 => return "https" else => return "http";
	};

const build_url := fn (scheme host : str, port : int, path : str) -> str => {
	let mut url := scheme & "://" & host;
	if port != default_port(scheme) => url &= ":" & port;
	if starts_with(path, "/") => url &= path else => url &= "/" & path;
	
	return url;
};

impl Http {
	const client := fn (host : str, port : int = 0) -> HttpClient => {
		let scheme := infer_scheme(host, port);
		let resolved_port := if port <= 0 => emit default_port(scheme) else => emit port;
		
		let client := HttpClient {host : normalize_host(host), port : resolved_port, headers : list:<str>[], scheme};
		return client;
	};

	const with_scheme := fn (host : str, port : int = 0, scheme : str) -> HttpClient => {
		let resolved_port := if port <= 0 => emit default_port(scheme) else => emit port;
		
		let client := HttpClient {host : normalize_host(host), port : resolved_port, headers : list:<str>[], scheme};
		return client;
	};

	const get := fn (url : str) -> HttpResponse => {
		let body := try http_request_try("GET", url, "") => http_request_raw("GET", url, "");
		return HttpResponse { status : 0, headers : list:<str>[], body };
	};

	const post := fn (url payload : str = "") -> HttpResponse => {
		let body := try http_request_try("POST", url, payload) => http_request_raw("POST", url, payload);
		return HttpResponse { status : 0, headers : list:<str>[], body };
	};

	const request := fn (method url payload : str = "") -> HttpResponse => {
		let body := try http_request_try(method, url, payload) => http_request_raw(method, url, payload);
		return HttpResponse { status : 0, headers : list:<str>[], body };
	};
};

impl HttpClient {
	const new := fn (host : str, port : int = 0) -> HttpClient => return Http.client(host, port);

	const with_scheme := fn (host : str, port : int = 0, scheme : str) -> HttpClient => return Http.with_scheme(host, port, scheme);

	const with_header := fn (self : HttpClient, value : str) -> HttpClient => {
		let mut next := HttpClient {host : self.host, port : self.port, headers : list:<str>[h for h in self.headers], scheme : self.scheme};
		next.headers <<= value;
		return next;
	};

	const header := fn (self : &mut HttpClient, value : str) => self.headers <<= value;

	const base_url := fn (self : HttpClient) -> str => return build_url(
		self.scheme,
		self.host,
		self.port,
		"/"
	);

	const request := fn (self : HttpClient, method path body : str = "") -> HttpResponse => {
		let url := build_url(
			self.scheme,
			self.host,
			self.port,
			path
		);
		
		return Http.request(method, url, body);
	};

	const get := fn (self : HttpClient, path : str) -> HttpResponse => return self.request("GET", path, "");

	const post := fn (self : HttpClient, path body : str = "") -> HttpResponse => return self.request("POST", path, body);
};

const http := fn (host : str, port : int = 0) -> HttpClient => return Http.client(host, port);
const connect := fn (host : str, port : int = 80) -> TcpStream => return Tcp.connect(host, port);
const listen := fn (host : str, port : int = 8080) -> TcpListener => return Tcp.listen(host, port);