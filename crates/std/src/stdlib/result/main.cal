impl<E, T> result:<E, T> {
	@pure
	const is_ok := fn (self : E!T) -> bool => match self {
		.Ok : _ => return true,
		.Err : _ => return false
	};

	@pure
	const is_err := fn (self : E!T) -> bool => match self {
		.Ok : _ => return false,
		.Err : _ => return true
	};

	@pure
	const map := fn <U> (self : E!T, op : fn (T) -> U) -> U!E => match self {
		.Ok : v => return ok(op(v)),
		.Err : e => return err(e)
	};

	@pure
	const map_err := fn <F> (self : E!T, op : fn (E) -> F) -> T!F => match self {
		.Ok : v => return ok(v),
		.Err : e => return err(op(e))
	};
};