@overload("as") fn<T>(self : list:<T>) -> null!gen:<T> =>
	return ok(fn<T> -> gen:<T> => {
		for i in len(self) => 
			return self[i]!;
	});

impl<T> list:<T> {
	@pure
	const len := fn (self : list:<T>) -> uint => return len(self);

	@pure
	const is_empty := fn (self : list:<T>) -> bool => return len(self) = 0u;

	@pure
	const first := fn (self : list:<T>) -> T? => return self[0];

	@pure
	const last := fn (self : list:<T>) -> T? => {
		return self[-1];
	};

	@pure
	const get := fn (self : list:<T>, idx : int) -> T? => {
		if (idx < 0) || (idx >= len(self)) => return none else => return self[idx];
	};

	@pure
	const clone := fn (self : list:<T>) -> list:<T> => return list:<T>[self[i]! for i in len(self)];

	@pure
	const contains := fn (self : list:<T>, needle : T) -> bool => {
		for i in len(self) => if self[i]! = needle => return true;
		return false;
	};

	@pure
	const index_of := fn (self : list:<T>, needle : T) -> uint? => {
		for i in len(self) => if self[i]! = needle => return some(i);
		return none;
	};

	@pure
	const last_index_of := fn (self : list:<T>, needle : T) -> uint? => {
		let mut i := len(self) - 1;
		
		for i >= 0 => {
			let value : T? = self[i]!;
			if value = needle => return some(i);
			if i = 0 => return none;
			i -= 1;
		};
		
		return none;
	};

	@pure
	const count := fn (self : list:<T>, needle : T) -> uint => {
		let mut n := 0u;
		for i in len(self) => if self[i]! = needle => n += 1u;
		return n;
	};

	@pure
	const split_at := fn (self : list:<T>, idx : int) -> <list:<T>, list:<T>> => {
		let cut := if idx < 0 => emit 0 else => emit if idx > len(self) => emit len(self) else => emit idx;
		return tuple(try self[0..cut] => emit list:<T>[], try self[cut..len(self)] => emit list:<T>[]);
	};

	@pure
	const reverse := fn (self : list:<T>) -> list:<T> => {
		let mut out := list:<T>[];
		
		let mut i := len(self) as! int - 1;
		
		for i >= 0 => {
			out <<= self[i -= 1]!;
		};
		
		return out;
	};

	const pop := fn (self : &mut list:<T>) -> T? => {
		let l := len(self);
		if l = 0u => return none;
		return raw_remove(self, l - 1);
	};

	const clear := fn (self : &mut list:<T>) => {
		self := move list:<T>[];
	};

	const remove := fn (self : &mut list:<T>, idx : uint) -> T? => {
		return raw_remove(self, idx);
	};

	const remove_value := fn (self : &mut list:<T>, needle : T) -> bool => {
		let idx := try self.index_of(needle) => return false;
		let _ := self.remove(idx);
		return true;
	};

	const insert := fn (self : &mut list:<T>, idx : int, value : T) -> bool => {
		return raw_insert(self, idx, value);
	};

	const extend := fn (self : &mut list:<T>, other : list:<T>) => {
		for i in len(other) => self <<= other[i]!;
	};

	@pure
	const concat := fn (self other : list:<T>) -> list:<T> => {
		for i in len(other) => self <<= other[i]!;
		return self;
	};

	@pure
	const sort := fn (self : list:<T>, compare : fn (T, T) -> int) -> list:<T> => return sort_by(self, compare);

	@pure
	const binary_search := fn (self : list:<T>, needle : T, compare : fn (T, T) -> int) -> int? => return binary_search_by(self, needle, compare);

	@pure
	const join := fn (self : list:<str>, sep : str = "") -> str => {
		let mut out := "";
		
		for i in len(self) => {
			if i > 0 => out &= sep;
			out &= self[i]!;
		};
		
		return out;
	};
};

@pure
impl list:<int> {
	const sum := fn (self : list:<int>) -> int => {
		let mut acc := 0;
		for i in len(self) => acc += self[i]!;
		return acc;
	};

	const min := fn (self : list:<int>) -> int? => {
		if len(self) = 0 => return none;
		let mut m := self[0]!;
		for i in 1..len(self) => if (self[i]!) < m => m := self[i]!;
		return some(m);
	};

	const max := fn (self : list:<int>) -> int? => {
		if len(self) = 0 => return none;
		let mut m := self[0]!;
		for i in 1..len(self) => if (self[i]!) > m => m := self[i]!;
		return some(m);
	};
};

@pure
impl list:<uint> {
	const sum := fn (self : list:<uint>) -> uint => {
		let mut acc := 0u;
		for i in len(self) => acc += self[i]!;
		return acc;
	};

	const min := fn (self : list:<uint>) -> uint? => {
		if len(self) = 0 => return none;
		let mut m := self[0]!;
		for i in 1..len(self) => if (self[i]!) < m => m := self[i]!;
		return some(m);
	};

	const max := fn (self : list:<uint>) -> uint? => {
		if len(self) = 0 => return none;
		let mut m := self[0]!;
		for i in 1..len(self) => if (self[i]!) > m => m := self[i]!;
		return some(m);
	};
};

@pure
impl list:<float> {
	const sum := fn (self : list:<float>) -> float => {
		let mut acc := 0f;
		for i in len(self) => acc += self[i]!;
		return acc;
	};

	const min := fn (self : list:<float>) -> float? => {
		if len(self) = 0u => return none;
		let mut m := self[0]!;
		for i in 1..len(self) => if (self[i]!) < m => m := self[i]!;
		return some(m);
	};

	const max := fn (self : list:<float>) -> float? => {
		if len(self) = 0u => return none;
		let mut m := self[0]!;
		for i in 1..len(self) => if (self[i]!) > m => m := self[i]!;
		return some(m);
	};

	const mean := fn (values : list:<float>) -> float => {
		if len(values) = 0u => return 0f;
		let mut acc := 0f;
		for i in len(values) => acc += values[i]!;
		return acc / (try len(values) as float => emit 1f);
	};

	const variance := fn (values : list:<float>) -> float => {
		let n := len(values);
		if n = 0 => return 0f;
		let m := values.mean();
		let mut acc := 0f;
		
		for i in n => {
			let d := (values[i]!) - m;
			acc += (d * d);
		};
		
		return acc / (try n as float => emit 1f);
	};

	const std_dev := fn (values : list:<float>) -> float => return values.variance() ** 0.5;

	const median := fn (values : list:<float>) -> float => {
		let n := len(values);
		if n = 0 => return 0f;
		
		let mut tmp := list:<float>[values[i]! for i in n];
		
		let mut i := 0;
		
		for i < n => {
			let mut j := 0;
			
			for (j + 1) < (n - i) => {
				if tmp[j]! > tmp[j + 1]! => {
					let t := tmp[j]!;
					tmp[j] := tmp[j + 1]!;
					tmp[j + 1] := t;
				};
				
				j += 1;
			};
			
			i += 1;
		};
		
		if (n % 2) = 1 => return tmp[n / 2]! else => return tmp[(n / 2) - 1]! + tmp[n / 2]! / 2f;
	};
};