impl<T> list:<T> {
	const len := fn (self : list:<T>) -> uint => return len(self);

	const iter := fn (self : &list:<T>) -> ListIter:<T> => return iter_list(self);

	const iter_mut := fn (self : &mut list:<T>) -> ListIter:<T> => return iter_list(self);

	const into_iter := fn (self : list:<T>) -> ListIter:<T> => return iter_list(self);

	const is_empty := fn (self : list:<T>) -> bool => return len(self) = 0u;

	const first := fn (self : list:<T>) -> T? => return self[0];

	const last := fn (self : list:<T>) -> T? => {
		return self[-1];
	};

	const get := fn (self : list:<T>, idx : int) -> T? => {
		if (idx < 0) || (idx >= len(self)) => return none else => return self[idx];
	};

	const clone := fn (self : list:<T>) -> list:<T> => return list:<T>[(try!! self[i]) for i in 0..len(self)];

	const contains := fn (self : list:<T>, needle : T) -> bool => {
		for i in 0..len(self) => if (try!! self[i]) = needle => return true;
		return false;
	};

	const index_of := fn (self : list:<T>, needle : T) -> int => {
		for i in 0..len(self) => if (try!! self[i]) = needle => return i;
		return -1;
	};

	const last_index_of := fn (self : list:<T>, needle : T) -> int => {
		let mut i := (len(self) as! int) - 1;
		
		for i >= 0 => {
			let value : T? = try!! self[i];
			if value = needle => return i;
			i -= 1;
		};
		
		return -1;
	};

	const count := fn (self : list:<T>, needle : T) -> uint => {
		let mut n := 0u;
		for i in 0..len(self) => if (try!! self[i]) = needle => n += 1u;
		return n;
	};

	const split_at := fn (self : list:<T>, idx : int) -> <list:<T>, list:<T>> => {
		let cut := if idx < 0 => emit 0 else => emit if idx > len(self) => emit len(self) else => emit idx;
		return tuple(try self[0..cut] => emit list:<T>[], try self[cut..len(self)] => emit list:<T>[]);
	};

	const take := fn (self : list:<T>, n : int) -> list:<T> => {
		let end := if n < 0 => emit 0 else => emit n;
		
		return try self[0..end] => emit list:<T>[];
	};

	const skip := fn (self : list:<T>, n : int) -> list:<T> => {
		let start := if n < 0 => emit 0 else => emit n;
		
		return try self[start..len(self)] => emit list:<T>[];
	};

	const reverse := fn (self : list:<T>) -> list:<T> => {
		let mut out := list:<T>[];
		
		let mut i := len(self) as! int - 1;
		
		for i >= 0 => {
			out <<= try!! self[i -= 1];
		};
		
		return out;
	};

	const pop := fn (self : &mut list:<T>) -> T? => {
		let l := len(self);
		if l = 0 => return none;
		return raw_remove(self, l - 1);
	};

	const clear := fn (self : &mut list:<T>) => {
		self := move list:<T>[];
	};

	const remove := fn (self : &mut list:<T>, idx : int) -> T? => {
		return raw_remove(self, idx);
	};

	const remove_value := fn (self : &mut list:<T>, needle : T) -> bool => {
		let idx := self.index_of(needle);
		if idx = -1 => return false;
		let _ := self.remove(idx);
		return true;
	};

	const insert := fn (self : &mut list:<T>, idx : int, value : T) -> bool => {
		return raw_insert(self, idx, value);
	};

	const extend := fn (self : &mut list:<T>, other : list:<T>) => {
		for i in 0..len(other) => self <<= try!! other[i];
	};

	const concat := fn (self other : list:<T>) -> list:<T> => {
		for i in 0..len(other) => self <<= try!! other[i];
		return self;
	};

	const sort := fn (self : list:<T>, compare : fn (T, T) -> int) -> list:<T> => return sort_by(self, compare);

	const binary_search := fn (self : list:<T>, needle : T, compare : fn (T, T) -> int) -> int? => return binary_search_by(self, needle, compare);

	const join := fn (self : list:<str>, sep : str = "") -> str => {
		let mut out := "";
		
		for i in 0..len(self) => {
			if i > 0 => out &= sep;
			out &= try!! self[i];
		};
		
		return out;
	};
};

impl list:<int> {
	const sum := fn (self : list:<int>) -> int => {
		let mut acc := 0;
		for i in 0..len(self) => acc += try!! self[i];
		return acc;
	};

	const min := fn (self : list:<int>) -> int? => {
		if len(self) = 0 => return none;
		let mut m := try!! self[0];
		for i in 1..len(self) => if (try!! self[i]) < m => m := try!! self[i];
		return some(m);
	};

	const max := fn (self : list:<int>) -> int? => {
		if len(self) = 0 => return none;
		let mut m := try!! self[0];
		for i in 1..len(self) => if (try!! self[i]) > m => m := try!! self[i];
		return some(m);
	};
};

impl list:<uint> {
	const sum := fn (self : list:<uint>) -> uint => {
		let mut acc := 0u;
		for i in 0..len(self) => acc += try!! self[i];
		return acc;
	};

	const min := fn (self : list:<uint>) -> uint? => {
		if len(self) = 0 => return none;
		let mut m := try!! self[0];
		for i in 1..len(self) => if (try!! self[i]) < m => m := try!! self[i];
		return some(m);
	};

	const max := fn (self : list:<uint>) -> uint? => {
		if len(self) = 0 => return none;
		let mut m := try!! self[0];
		for i in 1..len(self) => if (try!! self[i]) > m => m := try!! self[i];
		return some(m);
	};
};

impl list:<float> {
	const sum := fn (self : list:<float>) -> float => {
		let mut acc := 0f;
		for i in 0..len(self) => acc += try!! self[i];
		return acc;
	};

	const min := fn (self : list:<float>) -> float? => {
		if len(self) = 0u => return none;
		let mut m := try!! self[0];
		for i in 1..len(self) => if (try!! self[i]) < m => m := try!! self[i];
		return some(m);
	};

	const max := fn (self : list:<float>) -> float? => {
		if len(self) = 0u => return none;
		let mut m := try!! self[0];
		for i in 1..len(self) => if (try!! self[i]) > m => m := try!! self[i];
		return some(m);
	};

	const mean := fn (values : list:<float>) -> float => {
		if len(values) = 0u => return 0f;
		let mut acc := 0f;
		for i in 0..len(values) => acc += try!! values[i];
		return acc / (try len(values) as float => emit 1f);
	};

	const variance := fn (values : list:<float>) -> float => {
		let n := len(values);
		if n = 0 => return 0f;
		let m := values.mean();
		let mut acc := 0f;
		
		for i in 0..n => {
			let d := (try!! values[i]) - m;
			acc += (d * d);
		};
		
		return acc / (try n as float => emit 1f);
	};

	const std_dev := fn (values : list:<float>) -> float => return values.variance() ** 0.5;

	const median := fn (values : list:<float>) -> float => {
		let n := len(values);
		if n = 0 => return 0f;
		
		let mut tmp := list:<float>[(try!! values[i]) for i in 0..n];
		
		let mut i := 0;
		
		for i < n => {
			let mut j := 0;
			
			for (j + 1) < (n - i) => {
				if (try!! tmp[j]) > (try!! tmp[j + 1]) => {
					let t := try!! tmp[j];
					tmp[j] := try!! tmp[j + 1];
					tmp[j + 1] := t;
				};
				
				j += 1;
			};
			
			i += 1;
		};
		
		if (n % 2) = 1 => return try!! tmp[n / 2] else => return ((try!! tmp[(n / 2) - 1]) + (try!! tmp[n / 2]) / 2f);
	};
};