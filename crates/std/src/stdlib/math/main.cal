const PI := 3.141592653589793;
const TAU := 6.283185307179586;
const E := 2.718281828459045;
const EPSILON := 0.000000001;

impl int {
	const min := fn (a b : int) -> int => if a < b => return a else => return b;

	const max := fn (a b : int) -> int => if a > b => return a else => return b;

	const abs := fn (x : int) -> int => if x < 0 => return -x else => return x;

	const sign := fn (x : int) -> int => if x < 0 => return -1 else => if x > 0 => return 1 else => return 0;

	const clamp := fn (x lo hi : int) -> int => if x < lo => return lo else => if x > hi => return hi else => return x;

	const floor_div := fn (a b : int) -> int => {
		if b = 0 || a = 0 => return 0;
		let q := a / b;
		let r := a % b;
		if r != 0 && ((r > 0) != (b > 0)) => return q - 1 else => return q;
	};

	const ceil_div := fn (a b : int) -> int => {
		if b = 0 || a = 0 => return 0;
		let q := a / b;
		let r := a % b;
		if r != 0 && ((r > 0) = (b > 0)) => return q + 1 else => return q;
	};

	const pow := fn (base exp : int) -> int => {
		if exp < 0 => return 0;
		let mut b := base;
		let mut e := exp;
		let mut out := 1;
		
		for e > 0 => {
			if e % 2 = 1 => out *= b;
			b *= b;
			e /= 2;
		};
		
		return out;
	};

	const gcd := fn (a b : int) -> int => {
		let mut x := int.abs(a);
		let mut y := int.abs(b);
		
		for y != 0 => {
			let t := x % y;
			x := y;
			y := t;
		};
		
		return x;
	};

	const lcm := fn (a b : int) -> int => {
		if a = 0 || b = 0 => return 0 else => return int.abs((a / int.gcd(a, b)) * b);
	};

	const factorial := fn (n : int) -> int => {
		if n < 0 => return 0;
		let mut out := 1;
		let mut i := 2;
		
		for i <= n => {
			out *= i;
			i += 1;
		};
		
		return out;
	};

	const permutations := fn (n r : int) -> int => {
		if n < 0 || r < 0 || r > n => return 0 else => return int.factorial(n) / int.factorial(n - r);
	};

	const combinations := fn (n r : int) -> int => {
		if n < 0 || r < 0 || r > n => return 0 else => return int.factorial(n) / (int.factorial(r) * int.factorial(n - r));
	};

	const is_prime := fn (n : int) -> bool => {
		if n < 2 => return false;
		if n = 2 => return true;
		if n % 2 = 0 => return false;
		let mut d := 3;
		
		for d * d <= n => {
			if n % d = 0 => return false;
			d += 2;
		};
		
		return true;
	};
};

impl uint {
	const min := fn (a b : uint) -> uint => if a < b => return a else => return b;

	const max := fn (a b : uint) -> uint => if a > b => return a else => return b;

	const abs := fn (x : uint) -> uint => return x;

	const sign := fn (x : uint) -> int => if x = 0u => return 0 else => return 1;

	const clamp := fn (x lo hi : uint) -> uint => if x < lo => return lo else => if x > hi => return hi else => return x;

	const floor_div := fn (a b : uint) -> uint => if b = 0u => return 0u else => return a / b;

	const ceil_div := fn (a b : uint) -> uint => {
		if b = 0u => return 0u;
		let q := a / b;
		if a % b = 0u => return q else => return q + 1u;
	};

	const pow := fn (base exp : uint) -> uint => {
		let mut b := base;
		let mut e := exp;
		let mut out := 1u;
		
		for e > 0u => {
			if e % 2u = 1u => out *= b;
			b *= b;
			e /= 2u;
		};
		
		return out;
	};

	const gcd := fn (a b : uint) -> uint => {
		let mut x := a;
		let mut y := b;
		
		for y != 0u => {
			let t := x % y;
			x := y;
			y := t;
		};
		
		return x;
	};

	const lcm := fn (a b : uint) -> uint => {
		if a = 0u || b = 0u => return 0u else => return (a / uint.gcd(a, b)) * b;
	};

	const factorial := fn (n : uint) -> uint => {
		let mut out := 1u;
		let mut i := 2u;
		
		for i <= n => {
			out *= i;
			i += 1u;
		};
		
		return out;
	};

	const permutations := fn (n r : uint) -> uint => {
		if r > n => return 0u else => return uint.factorial(n) / uint.factorial(n - r);
	};

	const combinations := fn (n r : uint) -> uint => {
		if r > n => return 0u else => return uint.factorial(n) / (uint.factorial(r) * uint.factorial(n - r));
	};

	const is_prime := fn (n : uint) -> bool => {
		if n < 2u => return false;
		if n = 2u => return true;
		if n % 2u = 0u => return false;
		let mut d := 3u;
		
		for d * d <= n => {
			if n % d = 0u => return false;
			d += 2u;
		};
		
		return true;
	};	
};

impl float {
	const min := fn (a b : float) -> float => if a < b => return a else => return b;

	const max := fn (a b : float) -> float => if a > b => return a else => return b;

	const abs := fn (x : float) -> float => if x < 0f => return -x else => return x;

	const sign := fn (x : float) -> int => if x < 0f => return -1 else => if x > 0f => return 1 else => return 0;

	const clamp := fn (x lo hi : float) -> float => if x < lo => return lo else => if x > hi => return hi else => return x;

	const approx_eq := fn (a b : float, eps : float = EPSILON) -> bool => return float.abs(a - b) <= float.abs(eps);

	const trunc := fn (x : float) -> int => try x as int => return 0;

	const floor := fn (x : float) -> int => {
		let t := float.trunc(x);
		if x < 0f && (try t as float => 0f) != x => return t - 1 else => return t;
	};

	const ceil := fn (x : float) -> int => {
		let t := float.trunc(x);
		if x > 0f && (try t as float => 0f) != x => return t + 1 else => return t;
	};

	const floor_div := fn (a b : float) -> int => if b = 0f => return 0 else => return float.floor(a / b);

	const ceil_div := fn (a b : float) -> int => if b = 0f => return 0 else => return float.ceil(a / b);

	const round := fn (x : float) -> int => {
		if x >= 0f => return float.floor(x + 0.5) else => return float.ceil(x - 0.5);
	};

	const frac := fn (x : float) -> float => return x - (try float.floor(x) as float => 0f);

	const pow := fn (base : float, exp : int) -> float => {
		if exp = 0 => return 1f;
		if exp < 0 => return 1f / float.pow(base, -exp);
		
		let mut b := base;
		let mut e := exp;
		let mut out := 1f;
		
		for e > 0 => {
			if e % 2 = 1 => out *= b;
			b *= b;
			e /= 2;
		};
		
		return out;
	};

	const sqrt := fn (x : float) -> float => {
		if x <= 0f => return 0f;
		let mut guess := if x < 1f => emit 1f else => emit x;
		
		let mut i := 0;
		
		for i < 32 => {
			guess := 0.5 * (guess + (x / guess));
			i += 1;
		};
		
		return guess;
	};

	const cbrt := fn (x : float) -> float => {
		if x = 0f => return 0f;
		let mut guess := if float.abs(x) < 1f => emit x else => emit x / 3f;
		
		let mut i := 0;
		
		for i < 32 => {
			let g2 := guess * guess;
			if g2 = 0f => break;
			
			guess := (2f * guess + (x / g2)) / 3f;
			i += 1;
		};
		
		return guess;
	};

	const exp := fn (x : float) -> float => {
		let mut sum := 1f;
		let mut term := 1f;
		let mut n := 1;
		
		for n < 32 => {
			term *= x / (try n as float => 1f);
			sum += term;
			n += 1;
		};
		
		return sum;
	};

	const ln := fn (x : float) -> float => {
		if x <= 0f => return 0f;
		let mut y := 0f;
		let mut i := 0;
		
		for i < 24 => {
			let ey := float.exp(y);
			if ey = 0f => break;
			
			y -= ((ey - x) / ey);
			i += 1;
		};
		
		return y;
	};

	const log10 := fn (x : float) -> float => return float.ln(x) / float.ln(10f);

	const log2 := fn (x : float) -> float => return float.ln(x) / float.ln(2f);

	const normalize_radians := fn (x : float) -> float => {
		let mut y := x;
		for y > PI => y -= TAU;
		for y < -PI => y += TAU;
		return y;
	};

	const sin := fn (x : float) -> float => {
		let y := float.normalize_radians(x);
		let y2 := y * y;
		let y3 := y2 * y;
		let y5 := y3 * y2;
		let y7 := y5 * y2;
		return y - (y3 / 6f) + (y5 / 120f) - (y7 / 5040f);
	};

	const cos := fn (x : float) -> float => {
		let y := float.normalize_radians(x);
		let y2 := y * y;
		let y4 := y2 * y2;
		let y6 := y4 * y2;
		return 1f - (y2 / 2f) + (y4 / 24f) - (y6 / 720f);
	};

	const tan := fn (x : float) -> float => {
		let c := float.cos(x);
		if float.abs(c) <= EPSILON => return 0f else => return float.sin(x) / c;
	};

	const deg_to_rad := fn (deg : float) -> float => return deg * (PI / 180f);

	const rad_to_deg := fn (rad : float) -> float => return rad * (180f / PI);

	const lerp := fn (a b t : float) -> float => return a + ((b - a) * t);

	const inv_lerp := fn (a b v : float) -> float => if a = b => return 0f else => return (v - a) / (b - a);

	const remap := fn (in_min in_max out_min out_max value : float) -> float => {
		return float.lerp(out_min, out_max, float.inv_lerp(in_min, in_max, value));
	};	
};
