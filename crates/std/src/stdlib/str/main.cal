@pure
@overload("as") fn (self : str) -> gen:<char> => {
	for i in len(self) => 
		return try!! self[i];
}

impl str {
	@pure
	const len := fn (self : str) -> uint => return len(self);

	@pure
	const trim := fn (self : str) -> str => return trim(self);

	@pure
	const split := fn (self delim : str) -> list:<str> => return split(self, delim);

	@pure
	const contains := fn (self needle : str) -> bool => return contains(self, needle);

	@pure
	const starts_with := fn (self prefix : str) -> bool => return starts_with(self, prefix);

	@pure
	const ends_with := fn (self suffix : str) -> bool => return ends_with(self, suffix);

	@pure
	const is_empty := fn (self : str) -> bool => return len(self) = 0u;

	@pure
	const split_lines := fn (self : str) -> list:<str> => return split(self, "\n");

	@pure
	const lines := fn (self : str) -> list:<str> => return self.split_lines();

	@pure
	const split_at := fn (self : str, idx : int) -> <str, str> => {
		let l := len(self);
		let cut := if idx < 0 => emit 0 else => emit if idx > l => emit l else => emit idx;
		let mut left := "";
		let mut right := "";
		for i in 0..cut => left &= try!! self[i];
		for i in cut..l => right &= try!! self[i];
		return tuple(left, right);
	};

	@pure
	const repeat := fn (self : str, n : int) -> str => {
		if n <= 0 => "";
		let mut out := "";
		for _ in 0..n => out &= self;
		return out;
	};

	@pure
	const replace := fn (self needle to : str) -> str => {
		let parts := self.split(needle);
		if len(parts) = 0u => return self;
		let mut out := "";
		let mut idx := 0;
		
		for _ in parts => {
			if idx > 0 => out &= to;
			out &= try!! parts[idx];
			idx += 1;
		};
		
		return out;
	};

	@pure
	const strip_prefix := fn (self prefix : str) -> str? => {
		if !self.starts_with(prefix) => return none;
		let rest := self.split(prefix);
		if len(rest) <= 1u => some("");
		let mut out := "";
		let mut idx := 1;
		
		for _ in rest => {
			if (idx > 0) && (idx < len(rest)) => out &= try!! rest[idx];
			idx += 1;
		};
		
		return some(out);
	};

	@pure
	const strip_suffix := fn (self suffix : str) -> str? => {
		if !self.ends_with(suffix) => return none;
		let parts := self.split(suffix);
		if len(parts) <= 1 => return some("");
		let mut out := "";
		let mut idx := 0;
		
		for _ in parts => {
			if idx < len(parts) - 1 => out &= try!! parts[idx];
			idx += 1;
		};
		
		return some(out);
	};

	@pure
	const lowercase := fn (self : str) -> str => {
		let mut out := "";
		for i in len(self) => out &= (try!! self[i]).lowercase();
		return out;
	};

	@pure
	const uppercase := fn (self : str) -> str => {
		let mut out := "";
		for i in len(self) => out &= (try!! self[i]).uppercase();
		return out;
	};

	@pure
	const trim_start := fn (self : str) -> str => {
		let mut start := 0;
		for (start < len(self)) && (try!! self[start]).is_whitespace() => start += 1;
		let mut out := "";
		for i in start..len(self) => out &= try!! self[i];
		return out;
	};

	@pure
	const trim_end := fn (self : str) -> str => {
		let mut end := len(self);
		for (end > 0) && (try!! self[end - 1]).is_whitespace() => end -= 1;
		let mut out := "";
		for i in 0..end => out &= try!! self[i];
		return out;
	};

	@pure
	const is_whitespace := fn (self : str) -> bool => {
		for i in len(self) => if !(try!! self[i]).is_whitespace() => return false;
		return true;
	};
};

impl char {
	@pure
	const lowercase := fn (self : char) -> char => return char_lowercase(self);

	@pure
	const uppercase := fn (self : char) -> char => return char_uppercase(self);

	@pure
	const is_whitespace := fn (self : char) -> bool => {
		return (self = ' ') || (self = '\n') || (self = '\r') || (self = '\t');
	};

	@pure
	const is_digit := fn (self : char) -> bool => return (self >= '0') && (self <= '9');

	@pure
	const is_alphabetic := fn (self : char) -> bool => return self.lowercase() != self.uppercase();

	@pure
	const is_alphanumeric := fn (self : char) -> bool => return self.is_digit() || self.is_alphabetic();
};