impl range {
	const len := fn (self : range) -> int => return len(self);

	const start := fn (self : range) -> int => return min_or_zero(self);

	const end := fn (self : range) -> int => return len(self);

	const is_empty := fn (self : range) -> bool => return len(self) = min_or_zero(self);

	const contains := fn (self : range, value : int) -> bool => {
		let s : int = min_or_zero(self);
		let e : int = len(self);
		return value >= s && value < e;
	};

	const to_list := fn (self : range) -> list:<int> => {
		let mut out := list:<int>[];
		
		// TODO Fix range iter
		for i in self => out <<= i;
		return out;
	};

	const sum := fn (self : range) -> int => {
		let mut acc := 0;
		
		// TODO Fix range iter
		for i in self => acc += i;
		return acc;
	};

	const into_iter := fn (self : range) -> RangeIter => return iter_range(self);
};