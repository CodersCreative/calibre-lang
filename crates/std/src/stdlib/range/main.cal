@pure
@overload("as") fn (self : range) -> gen:<int> =>
	for i in self =>
		return i;

@pure
@overload("as") fn (self : range) -> null!list:<int> =>
	return ok(list:<int>[i for i in self]);

@pure
@overload("as") fn (self : range) -> null!list:<uint> =>
	return ok(list:<int>[i for i in 0..len(self)]);

impl range {
	@pure
	const len := fn (self : range) -> uint => return len(self);

	@pure
	const start := fn (self : range) -> int => return min_or_zero(self);

	@pure
	const end := fn (self : range) -> uint => return len(self);

	@pure
	const is_empty := fn (self : range) -> bool => return len(self) = min_or_zero(self);

	@pure
	const contains := fn (self : range, value : int) -> bool => {
		let s : int = min_or_zero(self);
		let e : int = len(self) as! int;
		return (value >= s) && (value < e);
	};

	@pure
	const sum := fn (self : range) -> int => {
		let mut acc := 0;
		
		for i in self => acc += i;
		return acc;
	};
};