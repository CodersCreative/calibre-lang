type Args := struct { };
type Vars := struct { };

impl Args {
	@pure
	const nth := fn (idx : uint) -> str? => return get(idx);

	@pure
	const all := fn -> list:<str> => {
		let mut out : list:<str> = list:<str>[];
		
		let mut idx := 0u;
		
		// Fix Args.nth
		for  => {
			match Args.nth(idx) as! str? {
				.Some : x => {
					out <<= x;
					idx += 1u;
				},
				.None => break
			};
		};
		
		return out;
	};

	@pure
	const count := fn -> uint => {
		let mut idx := 0u;
		
		for  => {
			match Args.nth(idx) as! str? {
				.Some : _ => idx += 1u,
				.None => break
			};
		};
		
		return idx;
	};

	@pure
	const first := fn -> str? => return get(0u);

	@pure
	const is_empty := fn -> bool => return Args.count() = 0u;
};

impl Vars {
	const get := fn (name : str) -> str? => return var(name);

	const has := fn (name : str) -> bool => match var(name) {
		.Some : _ => return true,
		.None => return false
	};

	const set := fn (name value : str) => set_var(name, value);

	const remove := fn (name : str) => remove_var(name);

	const vars := fn -> list:<str> => return vars();
};