type Args := struct { };
type Vars := struct { };

impl Args {
	const nth := fn (idx : int) -> str? => return get(idx);

	const all := fn -> list:<str> => {
		let mut out : list:<str> = list:<str>[];
		
		let mut idx := 0;
		
		// Fix Args.nth
		for  => {
			match Args.nth(idx) as! str? {
				.Some : x => {
					out <<= x;
					idx += 1;
				},
				.None => break
			};
		};
		
		return out;
	};

	const count := fn -> int => {
		let mut idx := 0;
		
		for  => {
			match Args.nth(idx) as! str? {
				.Some : _ => idx += 1,
				.None => break
			};
		};
		
		return idx;
	};

	const first := fn -> str? => return get(0);

	const is_empty := fn -> bool => return Args.count() = 0;
};

impl Vars {
	const get := fn (name : str) -> str? => return var(name);

	const has := fn (name : str) -> bool => match var(name) {
		.Some : _ => return true,
		.None => return false
	};

	const set := fn (name value : str) => set_var(name, value);

	const remove := fn (name : str) => remove_var(name);

	const vars := fn -> list:<str> => return vars();
};