type Channel:<T> := struct { inner : host };
type WaitGroup := struct { inner : host };
type Mutex:<T> := struct { inner : host };

type LazyLock:<T> := struct { inner : host, init_fn : fn () -> T };

impl<T> Channel:<T> {
	const new := fn -> Channel:<T> => return Channel:<T> { inner : channel_new() };

	const get := fn (self : &Channel:<T>, timeout_ms : uint = 100u) -> T? => return channel_get(self.inner, timeout_ms);

	const close := fn (self : &mut Channel:<T>) => channel_close(self.inner);

	const closed := fn (self : &Channel:<T>) -> bool => return channel_closed(self.inner);

	const send_all := fn (self : &mut Channel:<T>, values : list:<T>) => {
		for i in len(values) => emit self <- values[i]!;
	};

	const send := fn (self : &mut Self, value : T) -> bool => {
		return channel_send(self.inner, value);
	};
};

impl WaitGroup {
	const new := fn -> WaitGroup => return WaitGroup { inner : waitgroup_new() };

	const raw_new := fn (inner : host) -> WaitGroup => return WaitGroup { inner };

	const raw_add := fn (self : &mut WaitGroup, n : int) => waitgroup_raw_add(self.inner, n);

	const raw_done := fn (self : &mut WaitGroup) => waitgroup_raw_done(self.inner);

	const wait := fn (self : &WaitGroup) => waitgroup_wait(self.inner);

	const count := fn (self : &WaitGroup) -> int => return waitgroup_count(self.inner);

	const join :=
		fn (self : &mut WaitGroup, other : WaitGroup) => waitgroup_join(self.inner, other.inner);
};

impl<T> Mutex:<T> {
	const new := fn (value : T) -> Mutex:<T> => return Mutex:<T> { inner : mutex_new(value) };

	@ignore_invalid_return const get := fn (self : &Mutex:<T>) -> &mut T => return mutex_get(self.inner);

	const set := fn (self : &mut Mutex:<T>, value : T) => mutex_set(self.inner, value);

	@ignore_invalid_return const with := fn <U> (self : &mut Mutex:<T>, op : fn (T) -> U) -> U => {
		let cur : &mut T = mutex_get(self.inner);
		let result := op(cur.*);
		mutex_set(self.inner, result);

		return result;
	};

	const write := fn (self : &mut Mutex:<T>) -> &mut T => return mutex_write(self.inner);

	const swap := fn (self : &mut Mutex:<T>, value : T) -> T => {
		let current := self.get();
		self.set(value);
		return current.*;
	};

	const update := fn (self : &mut Mutex:<T>, op : fn (T) -> T) => {
		let cur : &mut T = mutex_get(self.inner);
		mutex_set(self.inner, op(cur.*));
	};
};

impl<T> LazyLock:<T> {
	const new := fn (init_fn : fn () -> T) -> LazyLock:<T> => {
		return LazyLock:<T> { inner : mutex_new(none), init_fn };
	};

	const get := fn (self : &Self) -> T? => {
		return mutex_get(self.inner).*
	};

	const get_or_init := fn (self : &Self) -> T => {
		let cur : T? = mutex_get(self.inner).*;
		if let .Some : let x <- cur => return x;

		mutex_set(self.inner, some(self.init_fn()));

		let cur : T? = mutex_get(self.inner).*;
		if let .Some : let x <- cur => return x;
		
		panic("LazyLock init failed");
	};

	const get_or_set := fn (self : &Self, default : T) -> T => {
		let cur : T? = mutex_get(self.inner).*;
		if let .Some : let x <- cur => return x;

		mutex_set(self.inner, some(default));

		let cur : T? = mutex_get(self.inner).*;
		if let .Some : let x <- cur => return x;
		
		panic("LazyLock init failed");
	};
};