type Channel:<T> := struct { inner : host };
type WaitGroup := struct { inner : host };
type Mutex:<T> := struct { inner : host };

type LazyLock:<T> := struct { inner : Mutex:<T?>, init_fn : fn () -> T };

impl<T> Channel:<T> {
	const new := fn -> Channel:<T> => return Channel:<T> { inner : channel_new() };

	const get := fn (self : &Channel:<T>) -> T? => return channel_get(self.inner);

	const try_get := fn (self : &Channel:<T>) -> T? => return channel_try_get(self.inner);

	const close := fn (self : &mut Channel:<T>) => channel_close(self.inner);

	const closed := fn (self : &Channel:<T>) -> bool => return channel_closed(self.inner);

	const send_all := fn (self : &mut Channel:<T>, values : list:<T>) => {
		for i in 0..len(values) => emit self values[i];
	};
};

impl<T> Send for Channel:<T> {
	type Item := T;

	const send := fn (self : &mut Self, value : Self::Item) -> bool => {
		return channel_try_send(self.inner, value);
	};
};

// TODO Find out whats still leaking raw WaitGroup's in spawn
impl WaitGroup {
	const new := fn -> WaitGroup => return WaitGroup { inner : waitgroup_new() };

	const raw_new := fn (inner : host) -> WaitGroup => return WaitGroup { inner };

	const raw_add := fn (self : &mut WaitGroup, value : int) => return waitgroup_raw_add((!(self.* is WaitGroup)) ? self : self.inner, value);

	const raw_done := fn (self : &mut WaitGroup) => waitgroup_raw_done((!(self.* is WaitGroup)) ? self : self.inner);

	const join :=
		fn (self : &mut WaitGroup, other : WaitGroup) => waitgroup_join((!(self.* is WaitGroup)) ? self : self.inner, (!(other.* is WaitGroup)) ? other : other.inner);

	const wait := fn (self : &WaitGroup) => waitgroup_wait((!(self.* is WaitGroup)) ? self : self.inner);

	const count := fn (self : &WaitGroup) -> int => return waitgroup_count((!(self.* is WaitGroup)) ? self : self.inner);
};

impl<T> Mutex:<T> {
	const new := fn (value : T) -> Mutex:<T> => return Mutex:<T> { inner : mutex_new(value) };

	@ignore_invalid_return const get := fn (self : &Mutex:<T>) -> &mut T => return mutex_get(self.inner);

	const set := fn (self : &mut Mutex:<T>, value : T) => mutex_set(self.inner, value);

	@ignore_invalid_return const with := fn <U> (self : &mut Mutex:<T>, op : fn (T) -> U) -> U => return mutex_with(self.inner, op);

	const write := fn (self : &mut Mutex:<T>) -> &mut T => return mutex_write(self.inner);

	const swap := fn (self : &mut Mutex:<T>, value : T) -> T => {
		let current := self.get();
		self.set(value);
		return current;
	};

	const update := fn (self : &mut Mutex:<T>, op : fn (T) -> T) => {
		let current := self.get();
		self.set(op(current));
	};
};

impl<T> LazyLock:<T> {
	const new := fn (init_fn : fn () -> T) -> LazyLock:<T> => return LazyLock:<T> { inner : Mutex:<T>.new(), init_fn };

	@ignore_invalid_return const get := fn (self : &Self) -> &mut T? => return self.inner.get();

	@ignore_invalid_return const get_or_init := fn (self : &Self) -> &mut T => {
		let value : &mut T? = self.inner.get();
		match value {
			.Some : x => x,
			.None => {
				value.* := self.init_fn();
				return try value => panic();
			}
		};
	};

	@ignore_invalid_return const get_or_set := fn (self : &Self, default : T) -> &mut T => {
		let value : &mut T? = self.inner.get();
		match value {
			.Some : x => x,
			.None => {
				value.* := default;
				return try value => panic();
			}
		};
	};
};