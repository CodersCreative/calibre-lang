type Channel:<T> := struct { };
type WaitGroup := struct { };
type Mutex:<T> := struct { };

impl<T> Channel:<T> {
	const new := fn -> Channel:<T> => return channel_new();

	const get := fn (self : &Channel:<T>) -> T? => return channel_get(self);

	const try_get := fn (self : &Channel:<T>) -> T? => return channel_try_get(self);

	const raw_send := fn (self : &mut Channel:<T>, value : T) -> bool => return channel_try_send(self, value);

	const close := fn (self : &mut Channel:<T>) => channel_close(self);

	const closed := fn (self : &Channel:<T>) -> bool => return channel_closed(self);

	const recv := fn (self : &Channel:<T>) -> T? => return self.get();

	const try_recv := fn (self : &Channel:<T>) -> T? => return self.try_get();

	const recv_or := fn (self : &Channel:<T>, default : T) -> T => {
		match self.get() {
			.Some : v => return v,
			.None => return default
		};
	};

	const send_all := fn (self : &mut Channel:<T>, values : list:<T>) => {
		for i in 0..len(values) => emit self values[i];
	};
};

impl WaitGroup {
	const new := fn -> WaitGroup => return waitgroup_new();

	const raw_add := fn (self : &mut WaitGroup, value : int) => return waitgroup_raw_add(self, value);

	const raw_done := fn (self : &mut WaitGroup) => waitgroup_raw_done(self);

	const join := fn (self : &mut WaitGroup, other : WaitGroup) => waitgroup_join(self, other);

	const wait := fn (self : &WaitGroup) => waitgroup_wait(self);

	const count := fn (self : &WaitGroup) -> int => return waitgroup_count(self);

	const wait_until_zero := fn (self : &WaitGroup) => self.wait();
};

impl<T> Mutex:<T> {
	const new := fn (value : T) -> Mutex:<T> => return mutex_new(value);

	const get := fn (self : &Mutex:<T>) -> T => return mutex_get(self);

	const set := fn (self : &mut Mutex:<T>, value : T) => mutex_set(self, value);

	const with := fn <U> (self : &mut Mutex:<T>, op : fn(T) -> U) -> U => return mutex_with(self, op);

	const write := fn (self : &mut Mutex:<T>) -> &mut T => return mutex_write(self);

	const swap := fn (self : &mut Mutex:<T>, value : T) -> T => {
		let current := self.get();
		self.set(value);
		return current;
	};

	const update := fn (self : &mut Mutex:<T>, op : fn(T) -> T) => {
		let current := self.get();
		self.set(op(current));
	};
};
