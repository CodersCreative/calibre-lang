const suspend := fn <T> (value : T) -> T => try gen_suspend(value) as T => value;

impl<T> Iter for gen:<T> {
	type Item := T;

	const next := fn (self : &mut gen:<T>) -> T? => {
		if self.done => return none;
		let value : T? = (self.data)();
		if value = none => {
			self.done := true;
			return none;
		};
		
		self.index += 1;
		return value;
	};
};

impl<T> gen:<T> {
	@ignore_invalid_type_check const iter := fn (self : Self) -> Self => return self;

	@ignore_invalid_type_check const iter_mut := fn (self : &mut Self) -> Self => return self.*;

	@ignore_invalid_type_check const into_iter := fn (self : Self) -> Self => return self;
};