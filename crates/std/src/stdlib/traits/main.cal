impl int {
	const default := fn => 0;
};

impl uint {
	const default := fn => 0;
};

impl float {
	const default := fn => 0f;
};

impl bool {
	const default := fn => false;
};

impl str {
	const default := fn => "";
};

impl char {
	const default := fn => '\0';
};

impl null {
	const default := fn => null;
};