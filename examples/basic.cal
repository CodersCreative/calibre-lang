type Stack := struct { values : list:<int> };

type Stack2 := struct (Stack);

type StackList := struct (list:<Stack2>);

const main := fn => {
	let mut arr := Stack { values : [0; 30] };
	arr.values[10] := 100;
	let mut arr2 := Stack2(move arr);
	arr2.0.values[9] := 90;
	let mut stacks := StackList(list:<Stack2>[move arr2]);
	stacks.0[0].0.values[8] := 80;
	print(stacks);
	let mut hashmap : HashMap:<str, str> = HashMap:<str, str>.new(("hello", "world"), ("world", "hello"));
	if let .Some : x <- hashmap.get("hello") => print(x);
	if let .Some : x <- hashmap.get("world") => print(x);
	if let .None <- hashmap.get("") => print("none");
};
