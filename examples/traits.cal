// import File from std::fs;

// Is being used as a trait
type Person := struct {
	name : str,
}

impl Person {
	const get_name := fn(self : &Self) -> str => 
		return self.name;

	const greeting := fn(self : &Self) -> str => 
		return "Hello " & self.get_name();
}

type User := struct { name : str };

// Basically implementing the trait
@overload("as") fn(self : User) -> null!Person => 
	return ok(Person {name : self.name});

// Is being used as a trait
@default
type Human := struct {
	name : str,
	age : uint = 10u,
	country : str = "Zimbabwe",
}

const show := fn (label : str, p : Human) => {
	print(label & " -> name=" & p.name & ", age=" & p.age & ", country=" & p.country);
};


type Ty := struct { };

@overload("as") fn(self : Ty) -> null!Human => {
	let mut human := Human.default();
	human.name = "Ty";
	return ok(human);
}

type Tadiwa := struct { };

@overload("as") fn(self : Tadiwa) -> null!Human =>
	return ok(Human {
		name : "Tadiwa",
		age : 21u,
		country : "United States"
	});


@current_context const main := fn => {
	let user := User { name : "Ty" };
	print((user as! Person).greeting());
	
	let parts := "a,b,c".split(",");
	// print(try parts[1] => emit "");
	print("calibre".starts_with("cal"));
	
	let ty := Ty { } as! Human;
	let tadiwa := Tadiwa { } as! Human;
	
	print(ty.name);
	print(ty.age);
	print(ty.country);
	
	print(tadiwa.name);
	print(tadiwa.age);
	print(tadiwa.country);
	
	show("ty", ty);
	show("tadiwa", tadiwa);
};