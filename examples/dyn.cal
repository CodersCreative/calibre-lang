trait State {
	const name : fn (&Self) -> str;

	const on_input : fn (&Self, str) -> dyn:<State>;

	const done : fn (&Self) -> bool;
};

type Locked := struct { attempts : int };
type Unlocked := struct { };
type Alarm := struct { };

impl Display for Locked {
	const display := fn (self : &Locked) -> str => return "Locked[" & self.attempts & "]";
};

impl Display for Unlocked {
	const display := fn (_self : &Unlocked) -> str => return "Unlocked[]";
};

impl Display for Alarm {
	const display := fn (_self : &Alarm) -> str => return "Alarm[]";
};

impl State for Locked {
	const name := fn (self : &Locked) -> str => return "Locked(" & self.attempts & ")";

	const done := fn (_self : &Locked) -> bool => return false;

	const on_input := fn (self : &Locked, input : str) -> dyn:<State> => {
		if input = "1234" => {
			return Unlocked { } as! dyn:<State>;
		} else if self.attempts >= 2 => {
			return Alarm { } as! dyn:<State>;
		} else => {
			return Locked { attempts : self.attempts + 1 } as! dyn:<State>;
		};
	};
};

impl State for Unlocked {
	const name := fn (_self : &Unlocked) -> str => return "Unlocked";

	const done := fn (_self : &Unlocked) -> bool => return true;

	const on_input := fn (_self : &Unlocked, input : str) -> dyn:<State> => {
		if input = "lock" => {
			return Locked { attempts : 0 } as! dyn:<State>;
		} else => {
			return Unlocked { } as! dyn:<State>;
		};
	};
};

impl State for Alarm {
	const name := fn (_self : &Alarm) -> str => return "Alarm";

	const done := fn (_self : &Alarm) -> bool => return true;

	const on_input := fn (_self : &Alarm, input : str) -> dyn:<State> => {
		if input = "reset" => {
			return Locked { attempts : 0 } as! dyn:<State>;
		} else => {
			return Alarm { } as! dyn:<State>;
		};
	};
};

const main := fn => {
	print(Locked { attempts : 2 });
	print(Unlocked { });
	print(Alarm { });
	
	print(Locked { attempts : 7 }.name());
	print(Unlocked { }.name());
	print(Alarm { }.name());
	
	let mut state : dyn:<State> = Locked { attempts : 0 };
	let inputs := list:<str>["0000", "1111", "0000", "reset", "1234"];
	
	for input in inputs => {
		print("state=" & state.name() & " input=" & input);
		state := state.on_input(input);
		
		match state {
			is Locked => print("Locked"),
			is Unlocked => print("Unlocked"),
			is Alarm => print("Alarm")
		};
	};
};
