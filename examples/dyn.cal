type Locked := struct { attempts : int };

@overload("as") fn(self : Locked) -> null!str => 
	return ok("Locked[" & self.attempts & "]");

type Unlocked := struct { };

@overload("as") fn(self : Unlocked) -> null!str =>
	return ok("Unlocked[]");

type Alarm := struct { };

@overload("as") fn(self : Alarm) -> null!str =>
	return ok("Alarm[]");

impl Locked {
	const name := fn (self : &Locked) -> str => return "Locked(" & self.attempts & ")";
	
	const done := fn (_self : &Locked) -> bool => return false;
	
	const on_input := fn (self : &Locked, input : str) -> dyn => {
		@ignore_invalid_comparison if input = "1234" => {
			return Unlocked { };
		} else if 2 <= self.attempts  => {
			return Alarm { };
		} else => {
			return Locked { attempts : self.attempts + 1 };
		};
	};
};

impl Unlocked {
	const name := fn (_self : &Unlocked) -> str => return "Unlocked";
	
	const done := fn (_self : &Unlocked) -> bool => return true;
	
	const on_input := fn (_self : &Unlocked, input : str) -> dyn => {
		if input = "lock" => {
			return Locked { attempts : 0 };
		} else => {
			return Unlocked { };
		};
	};
};

impl Alarm {
	const name := fn (_self : &Alarm) -> str => return "Alarm";
	
	const done := fn (_self : &Alarm) -> bool => return true;
	
	const on_input := fn (_self : &Alarm, input : str) -> dyn => {
		if input = "reset" => {
			return Locked { attempts : 0 };
		} else => {
			return Alarm { };
		};
	};
};

const main := fn => {
	print(Locked { attempts : 2 });
	print(Unlocked { });
	print(Alarm { });
	
	print(Locked { attempts : 7 }.name());
	print(Unlocked { }.name());
	print(Alarm { }.name());
	
	let mut state : dyn = Locked { attempts : 0 };
	let inputs := list:<str>[
		"0000",
		"1111",
		"0000",
		"reset",
		"1234"
	];
	
	for input in inputs => {
		match state {
			is Locked => {
				print("state=" & state.name() & " input=" & input);
				state := state.on_input(input);

				print("Locked");
			},
			is Unlocked => {
				print("state=" & state.name() & " input=" & input);
				state := state.on_input(input);

				print("Unlocked")
			},
			is Alarm => {
				print("state=" & state.name() & " input=" & input);
				state := state.on_input(input);

				print("Alarm")
			}
		};
	};
};
