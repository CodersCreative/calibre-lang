@init(10) const setup := fn => {
	print("Setting up...");
};

@init(5) const load := fn => {
	print("Loading...");
};

// @init(0)
const main := fn => {
	print("Running");

	// The @os tag can be used to make any statement only run a specific os
	@os("linux", "macos") print("on either linux or macos");
	@os("linux") print("on linux");
	@os("macos") print("on macos");
	@os("windows") print("on windows");

	// When I eventually get to making another backend, 
	// this statement will allow you to only run a statement on a specific area_of_triangle
	@backend("interpreter") print("on the rust-based interpreter");
};

@fin(10) const cleanup := fn => {
	print("Cleaning up...");
};

@fin(5) const close := fn => {
	print("Closing...");
};

@fin(0) const save := fn => {
	print("Saving...");
};

// @init(100)
@init const logging := fn => {
	print("Logs are totally starting...");
};

@init const init := fn => {
	print("Init...");
};