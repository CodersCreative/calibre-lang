import (Path, Dir, FileType) from std::fs;

// Fix memo with Path that way we can remove dir_name
@pure(memo(dir_name));
const get_tree_output := fn (dir_name : str, path : Path, depth : int = 100) -> str => {
	if depth <= 0 => return "";
	let objects : str!list:<DirEntry> = path.read_dir();
	let objects : list:<DirEntry> = try objects => panic();
	if objects.is_empty() => return "";

	let mut out := "\t";
	
	for object in objects => {
		out &= object.file_name() & "\n";
		let typ : str!FileType = object.file_type();
		let typ : FileType = try typ => panic();
		if typ.is_dir() => {
			let dir_out := get_tree_output(object.file_name(), object.path(), depth - 1);
			if !dir_out.is_empty() => {
				out &= dir_out; 
				out &= "\n";
			}
		};
	};
	
	return out.replace("\n", "\n\t");
};

@current_context const main := fn => {
	let path : Path = Path.new(current_context.path.replace("examples/tree.cal", "."));
	print(get_tree_output("", path));
};