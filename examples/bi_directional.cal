type Vector2 := struct {
    x y : int
};

@overload("as") fn(self : Vector2) -> null!str =>
    return ok("x : " & self.x & ", y : " & self.y )

@overload("as") fn(self : Vector2) -> null!int => 
    return ok((self.x * self.x + self.y * self.y) ** 0.5 )

@overload("as") fn(nums : <int, int>) -> null!Vector2 =>
    return ok(Vector2{
        x : nums.0,
        y : nums.1,
    });

type Vector3 := struct(float, float, float);


type Language := enum {
	// Enums can have hasmap type data structuress.
	FRENCH : float,
	// Enums can have tuple type data structuress.
	ENGLISH : int,
	SPANISH,
	ARABIC : <Language, Language>
};

type Number := struct(int);

@overload("as") fn(num : int) -> null!Number =>
    return ok(Number(num))


const going_to_err := fn -> int!Vector2 => {
    let errored_var : Vector2!Vector2 = err(Vector2 { x : 100, y : 9000});
    // It should convert the error type into a int
    return ok(try errored_var);
}

const takes_in_coerced_vec := fn(vec : Vector2) =>
    print("coerced vec as func param " & vec);

const main := fn => {
    let lst : list:<int> = [];
    print([lst as! str]);
    let vec2 : Vector2 = .{
        x : 100,
        y : 4
    };
    print(vec2);
    let vec3 : Vector3 = .(40.0, 10.3, 30.2);
    print(vec3);
    let res : str!int = .Ok : 100;
    print(res);
    let mut lang : Language = .SPANISH;
    print(lang);
    lang := .ENGLISH : 1;
    print(lang)
    
    let my_coerced_int : int = 10.38322;
    print("coerced int : ", my_coerced_int);

    let my_coerced_number : Number = 10;
    print("coerced number : ", my_coerced_number);

    let mut my_coerced_vec : Vector2 = (10, 30);
    print("coerced vec : ", my_coerced_vec);
    my_coerced_vec := (80, 20);
    print("coerced vec : ", my_coerced_vec);

    takes_in_coerced_vec((20, 40));

    print("coerced return error type : ", going_to_err());

    let mut my_list : list:<int> = [90, 39];
    my_list[1]! += 39;
    print(my_list[1]!); 
}
