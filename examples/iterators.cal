type Counter := struct { current end : int };

@overload("as") fn (self : Counter) -> gen:<int> => {
	if self.current >= self.end => return;
	
	let value := self.current;
	self.current := self.current + 1;
	return value;
}

const main := fn => {
	print("Starting: ");
	let mut list_it : gen:<int> = list:<int>[1, 2, 3] as! gen:<int>;
	
	for  => {
		let next := list_it.next();
		match next {
			.Some : value => print(value),
			_ => break
		};
	};
	
	print("\nRanges: ");
	let mut range_it : gen:<int> = (0..3) as! gen:<int>;
	
	for  => {
		let next := range_it.next();
		match next {
			.Some : value => print(value),
			_ => break
		};
	};
	
	print("\nFor let: ");
	let mut counter := Counter { current : 5, end : 8 } as! gen:<int>;
	for let .Some : value <- counter.next() => print(value);
	
	print("\nMap: ");
	let mapped := (list:<int>[1, 2, 3] as! gen:<int>).map(fn (x : int) -> int => return x * 2).collect();
	print(mapped);
	
	print("\nFilter: ");
	let filtered := (list:<int>[
		1,
		2,
		3,
		4
	] as! gen:<int>).filter(fn (x : int) -> bool => return (x % 2) = 0).collect();
	print(filtered);
	
	print("\nFold: ");
	let sum := list:<int>[
		1,
		2,
		3,
		4
	] as! gen:<int>.fold(0, fn (acc x : int) -> int => return acc + x);
	print(sum);
	
	print("\nAny: ");
	let any_big := list:<int>[1, 2, 3] as! gen:<int>.any(fn (x : int) -> bool => return x > 2);
	print(any_big);
	
	print("\nAll: ");
	let all_pos := list:<int>[1, 2, 3] as! gen:<int>.all(fn (x : int) -> bool => return x > 0);
	print(all_pos);
	
	print("\nFind: ");
	let found := list:<int>[3, 4, 5] as! gen:<int>.find(fn (x : int) -> bool => return x = 4);
	print(found);
	
	print("\nTake: ");
	let taken := list:<int>[
		1,
		2,
		3,
		4,
		5
	] as! gen:<int>.take(3).collect();
	print(taken);
	
	print("\nSkip: ");
	let skipped := list:<int>[
		1,
		2,
		3,
		4,
		5
	] as! gen:<int>.skip(2).collect();
	print(skipped);
	
	print("\nEnumerate: ");
	let mut enumerated := list:<int>[10, 20, 30] as! gen:<int>.enumerate();
	print(enumerated.next());
	print(enumerated.next());
	
	print("\nStep by: ");
	let mut stepped := list:<int>[
		1,
		2,
		3,
		4,
		5,
		6
	] as! gen:<int>.step_by(2);
	print(stepped.next());
	print(stepped.next());
};