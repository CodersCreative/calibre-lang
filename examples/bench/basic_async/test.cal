import WaitGroup from std::async;

const worker := fn (id : int) => {
	let x := 10000000 / 3 + 5;
	console_output(1, "worker " & (id + x) & " done" & "\n");
};

const main := fn => {
	let mut wg := WaitGroup.new();
	
	for i in 0..8 => 
		wg.join(spawn worker(i));
	
	wg.wait();
	print("all workers finished");
};