const fib := fn (n : int) -> int => {
    let mut a := 0;
    let mut b := 1;
    
    for _ in n =>
        b += (a := b);

    return a;
};

const main := fn => {
	let n := 28
	let result := fib(n);
	print(result);
};

@bench test "fib" => main();

test "fib_10" => assert(fib(10) = 55, "Fib 10 did not equal 55 as expected");