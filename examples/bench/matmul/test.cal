const matmul := fn (a b : list:<list:<float>>) -> list:<list:<float>> => {
	let n := len(a);
	let m := len(b[0]!);
	let p := len(a[0]!);
	let mut c := list:<list:<float>>[];
	
	for i in n => {
		let mut ci := list:<float>[0f for n];
		
		for k in p => {
			let aik : float = a[i][k]!;
			let bk : list:<float> = b[k]!;
			
			for j in m => ci[j]! += aik * try bk[j] => emit 0;
		};
		
		c <<= ci;
	};
	
	return c;
};

const main := fn => {
	print("Starting");
	const n : int = 100;
	let tmp : float = (1f / n) / n;

	let a := list:<list:<float>>[list:<float>[tmp * (i - j) * (i + j) for j in n] for i in n];
	let b := list:<list:<float>>[list:<float>[tmp * (i - j) * (i + j) for j in n] for i in n];

	let d := matmul(a, b);

	print("Finished");
	print(d[n / 2][n / 2]!);
	print("Success");
};

@bench test "matmul" => main();
