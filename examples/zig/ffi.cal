// TODO Fix - FAILING - Path resolution of libraries is failing
type Point := struct { x y : @i64 };

extern "zig" const zig_add := fn(@i32, @i32) -> @i32 from "libffi" as "zig_add";
extern "zig" const zig_dot := fn(Point) -> @i64 from "libffi" as "zig_dot";
extern "zig" const zig_sum_bytes := fn(ptr:<@u8>, @usize) -> @i64 from "libffi" as "zig_sum_bytes";

const main := fn => {
	let value := zig_add(40, 2);
	print(value);
	
	let pt := Point { x : 6, y : 7 };
	print(pt);
	let dot : int = zig_dot(pt);
	print(dot);
	
	let nums := [
		1,
		2,
		3,
		4,
		5,
		6
	];
	
	let total := zig_sum_bytes(nums as! ptr:<byte>, len(nums));
	print(total);
};