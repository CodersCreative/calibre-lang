type GenericAnimal := struct {
	Name Sound : str,
	Size Intelligence : int
};

impl GenericAnimal {
	const new := fn (Name Sound : str, Size Intelligence : int) -> Self => return GenericAnimal {Name, Sound, Size, Intelligence};
	
	const name := fn (self : &Self) -> str => return self.Name;
	
	const sound := fn (self : &Self) -> str => return self.Sound;
	
	const size := fn (self : &Self) -> int => return self.Size;
	
	const intelligence := fn (self : &Self) -> int => return self.Intelligence;
	
	const description := fn (self : &Self) -> str => {
		return "The animal's name is " & self.name() & ", it makes a " & self.sound() & ", its size is " & self.size() & " and its intelligence level is " & self.intelligence();
	};
};

type Parrot := struct {
	Name Sound : str,
	Size Intelligence WingSpan NumberWords : int
};

impl Parrot {
	const new := fn (
		Name: str,
		Sound: str,
		Size: int,
		Intelligence: int,
		WingSpan: int,
		NumberWords: int
	) -> Self => return Parrot {Name, Sound, Size, Intelligence, WingSpan, NumberWords};
	
	const name := fn (self : &Self) -> str => return self.Name;
	
	const sound := fn (self : &Self) -> str => return self.Sound;
	
	const size := fn (self : &Self) -> int => return self.Size;
	
	const intelligence := fn (self : &Self) -> int => return self.Intelligence;
	
	const ChangeNumberWords := fn (self : &mut Self, words : int) => self.NumberWords += words;
	
	const description := fn (self : &Self) -> str => {
		return "The animal's name is " & self.Name & ", it makes a " & self.Sound & ", its size is " & self.Size & " and its intelligence level is " & self.Intelligence & ". Its has a wingspan of " & self.WingSpan & " cm and can say " & self.NumberWords & " words.";
	};
};

type Wolf := struct {
	Name Sound : str,
	Size Intelligence TerritorySize : int
};

impl Wolf {
	const new := fn (Name Sound : str, Size Intelligence TerritorySize : int) -> Self => return Wolf {Name, Sound, Size, Intelligence, TerritorySize};
	
	const name := fn (self : &Self) -> str => return self.Name;
	
	const sound := fn (self : &Self) -> str => return self.Sound;
	
	const size := fn (self : &Self) -> int => return self.Size;
	
	const intelligence := fn (self : &Self) -> int => return self.Intelligence;
	
	const SetTerritorySize := fn (self : &mut Self, size : int) => self.TerritorySize := size;
	
	const description := fn (self : &Self) -> str => {
		return "The animal's name is " & self.Name & ", it makes a " & self.Sound & ", its size is " & self.Size & " and its intelligence level is " & self.Intelligence & ". Its territory is " & self.TerritorySize & " square miles.";
	};
};

const main := fn => {
	let mut parrot := Parrot.new(
		"Chewie",
		"Squawk",
		1,
		10,
		30,
		29
	);
	
	let mut wolf := Wolf.new(
		"Nighteyes",
		"Howl",
		8,
		7,
		100
	);
	
	const horse := GenericAnimal.new(
		"Cooper",
		"Neigh",
		10,
		6
	);
	
	wolf.SetTerritorySize(80);
	parrot.ChangeNumberWords(2);
	
	print(parrot.description());
	print(wolf.description());
	print(horse.description());
	
	let mut animal : dyn = wolf;
	
	match animal {
		is Wolf => {
			print(animal);
			print(animal.description());
			print(animal.TerritorySize);
		},
		is Parrot => {
			print(animal);
			print(animal.description());
			print(animal.WingSpan);
		},
		_ => print("Not Wolf or Parrot")
	};
};
