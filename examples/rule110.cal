const width := 50;
const steps := 50;

const main := fn => {
	const half_width : int = width / 2;
	let mut cells := list:<int>[1 if x > half_width else 0 for x in 0..=width];
	
	for step in steps => {
		let mut line := "";
		for i in 0..len(cells) => line &= "█" if cells[i] = 1 else " ";
		print(line);
		let mut next_cells := list:<int>[];
		
		for i in 0..len(cells) => {
			let left := cells[i - 1] if i > 0 else 0;
			let center := cells[i];
			let right := cells[i + 1] if i < len(cells) - 1 else 0;
			
			if left = 1 => {
				if center = 1 => {
					if right = 1 => next_cells <<= 0 else => next_cells <<= 1;
				} else => {
					if right = 1 => next_cells <<= 1 else => next_cells <<= 0;
				};
			} else => {
				if center = 1 => {
					if right = 1 => next_cells <<= 1 else => next_cells <<= 1;
				} else => {
					if right = 1 => next_cells <<= 1 else => next_cells <<= 0;
				};
			};
		};
		
		cells := move next_cells;
	};
};