@init(10) const early_setup := fn -> result:<int, str> => {
	print("early setup ok");
	return ok(0);
};

@init(5) const load := fn => {
	print("load");
};

const main := fn -> option:<int> => {
	print("main");
	return some(0);
};

@fin(10) const cleanup := fn => {
	print("cleanup");
};

@fin(5) const report := fn -> result:<int, str> => {
	print("report fin");
	return err("shutdown reported a problem");
};
