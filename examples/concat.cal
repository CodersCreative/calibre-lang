const sec := 30;

const main := fn => {
	let out := "";
	out &= hour;
	out := out & ":" & min;
	out &= ":" & sec;
	
	print(out);
	
	print(fmt"{hour}:{min}:{sec}");
	
	print(hour & ":" & min & ":" & sec);
};